<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ELP-Framework - Beta</title>
    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f8fafc;
            color: #1a202c;
            display: flex;
            justify-content: center;
            align-items: center;
            /*height: 100vh;*/
            /*text-align: center;*/
        }

        .container {
            width: 900px;
            max-width: 900px;
            padding: 2rem;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: #2d3748;
            text-align: center;
        }

        .badge {
            display: inline-block;
            background-color: #ecc94b;
            color: #744210;
            padding: 0.25rem 0.6rem;
            font-size: 0.75rem;
            border-radius: 999px;
            margin-bottom: 1rem;
            text-transform: uppercase;
            font-weight: bold;
        }

        .logo {
            display: block;
            margin: 0 auto; /* Centraliza horizontalmente */
            width: 150px;
            height: 150px;
            object-fit: cover; /* Garante que a imagem cubra o círculo */
            border-radius: 50%; /* Deixa a imagem circular */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* Sombra leve para destaque */
        }

        p {
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
        }

        h2 {
            margin-top: 2rem;
            font-size: 1.5rem;
            color: #4a5568;
            text-align: left;
        }

        ul.features {
            list-style: none;
            padding: 0;
            text-align: left;
        }

        ul.features li::before {
            content: "✔️";
            margin-right: 0.5rem;
            color: green;
        }

        .footer {
            margin-top: 2rem;
            font-size: 0.9rem;
            color: #a0aec0;
        }
    </style>
</head>
<body>
<div class="container">

    <p><img src="{{ asset('images/borlotti.png') }}" class="logo" alt="Logo"></p>
    <h1>
        Welcome to Borlotti App
        <br/>
        <div class="badge">Beta</div>
    </h1>
    <p>This page displays some examples of libraries available by default.</p>

    <a href="{{ url_for('welcome') }}">Home page</a>

    <h2>Encrypt lib</h2>
    <p>Key: {{ key }}</p>
    <p>Encrypted data: {{ token }}</p>
    <p>Original data: {{ original }}</p>
    <p>Hash: {{ hash }}</p>
    <p>Valid: {{ valid }}</p>

    <h2>Json lib</h2>
    <p>Json encode: {{ json }}</p>
    <p>Json decode:</p>
    {% for key, value in array %}
        <p>{{ key }} -> {{ value }}</p>
    {% endfor %}
    {% if json_error %}
        <p>Things</p>
    {% endif %}

    <h2>Date lib</h2>
    <p>From timestamp to formatted date: {{ data_formatada }}</p>
    <p>From date to timestamp: {{ data_timestamp }}</p>
    <p>Localization with month name in Portuguese: {{ data_localizada_pt }}</p>
    <p>Localization with French: {{ data_localizada_fr }}</p>

    <h2>Session lib</h2>
    <p>Session ID: {{ session_id }}</p>
    <p>User Id retrieved from session: {{ user_id_recuperado }}</p>
    <p>Flash message: {{ flash_message }}</p>

    <div class="footer">
        This is a demo page of the <b>Borlotti App</b>.
    </div>
</div>
</body>
</html>
